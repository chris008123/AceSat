ENVIRONMENT=development

# --- Database (Supabase) ---
# Supabase gives you two connection strings (Project Settings -> Database):
#
# 1. Direct connection — simplest, works fine for the hackathon. Port 5432.
#    postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
#
# 2. Connection pooler (Supavisor) — use this instead if you expect many
#    short-lived connections (e.g. serverless deploy). Port 6543, and note
#    the username becomes "postgres.[PROJECT-REF]" not just "postgres".
#    postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
#
# Either way, Supabase requires SSL — add ?sslmode=require if it's not
# already appended in the string Supabase gives you.
#
# Uncomment and fill in one of these:
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require

JWT_SECRET=change-me-to-a-real-secret
AI_API_KEY=
CORS_ORIGINS=["http://localhost:3000"]
