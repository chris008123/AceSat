ENVIRONMENT=development

# --- Database (Supabase) ---
# RECOMMENDED: the connection pooler (Session mode, port 5432). Supabase's
# *direct* connection hostname (db.[PROJECT-REF].supabase.co) is IPv6-only
# unless you've paid for the IPv4 add-on — on a network that doesn't route
# IPv6 properly, that host fails to resolve at all ("could not translate
# host name ... Unknown server error"). The pooler hostname is
# IPv4-compatible and avoids this entirely.
#
# Get it from: Project Settings -> Database -> Connection pooling ->
# Session mode. Note the username changes to "postgres.[PROJECT-REF]",
# not just "postgres".
#
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require
#
# Alternative — direct connection (Project Settings -> Database ->
# Connection string). Only use this if the pooler isn't an option for some
# reason; more likely to hit the IPv6 DNS issue above.
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require

JWT_SECRET=change-me-to-a-real-secret
AI_API_KEY=
CORS_ORIGINS=["http://localhost:3000"]
